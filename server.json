{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.LinuxLinking/ocr-mcp",
  "title": "OCR MCP",
  "description": "OCR for agents via PaddleOCR: text, table, handwriting and formula recognition with LaTeX output.",
  "version": "0.1.1",
  "repository": {
    "url": "https://github.com/LinuxLinking/ocr-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "ocr-mcp",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "tools": [
    {
      "name": "ocr_recognize",
      "description": "General text recognition from an image"
    },
    {
      "name": "ocr_table",
      "description": "Table extraction returning structured text"
    },
    {
      "name": "ocr_handwrite",
      "description": "Handwriting recognition"
    },
    {
      "name": "ocr_formula",
      "description": "Math formula recognition returning LaTeX"
    }
  ],
  "keywords": [
    "ocr",
    "paddleocr",
    "mcp",
    "text-recognition",
    "latex",
    "table-recognition"
  ]
}